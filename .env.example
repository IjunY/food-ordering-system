APP_ENV=dev
POSTGRES_USER=meal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meal

DATABASE_URL=postgresql://meal:change-me@localhost:5433/meal

# Signs login tokens. At least 32 characters; generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-0123456789

# Shared secret that signs payment callbacks (mock provider). At least 32 characters; generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=change-me-to-another-long-random-string-0123456789
# Minutes before an unpaid payment expires
PAYMENT_EXPIRE_MINUTES=15

# Which payment provider the "pay" button uses:
#   mock    - the backend's own checkout page with success / fail buttons (no account needed)
#   linepay - LINE Pay sandbox: no real money. Create a sandbox channel at
#             https://pay.line.me/tw/developers/techsupport/sandbox/creation
#             and put the Channel ID and Channel Secret it sends you below.
PAYMENT_PROVIDER=mock
PAYMENT_LINEPAY_CHANNEL_ID=
PAYMENT_LINEPAY_CHANNEL_SECRET=
# PAYMENT_LINEPAY_API_URL=https://sandbox-api-pay.line.me   (the default; the live API is https://api-pay.line.me)

# The address people open the app at; links in emails (password reset) point here.
# For a demo with other computers on the same network, use that address instead,
# e.g. http://192.168.1.23:8000
APP_URL=http://localhost:8000

# Sending email (sign-up codes, "forgot password" links) from the project's Gmail
# account. MAIL_SMTP_PASSWORD is that account's app password (16 letters, made at
# https://myaccount.google.com/apppasswords while signed in as it), not its normal
# password; ask the team for it and never commit it. Until it is filled in, no
# email is sent: in development it is printed in the server log instead
# (docker compose logs app). Leave MAIL_SMTP_HOST empty to always do that.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=nthu.mealorder@gmail.com
MAIL_SMTP_PASSWORD=
# From address; defaults to MAIL_SMTP_USERNAME
MAIL_SENDER=nthu.mealorder@gmail.com

# Demo data. When set, the first `docker compose up` also loads the NTHU stalls and
# menus plus three demo accounts with this password (at least 8 characters):
# 112012345 (customer), staff (vendor 牛肉先生) and admin. Later starts leave the
# data alone. Leave it empty for an empty database (e.g. a real deployment).
DEMO_PASSWORD=
