APP_ENV=dev
POSTGRES_USER=meal
POSTGRES_PASSWORD=change-me
POSTGRES_DB=meal

DATABASE_URL=postgresql://meal:change-me@localhost:5433/meal

# Signs login tokens. At least 32 characters; generate your own with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-0123456789

# Shared secret that signs payment callbacks (mock provider). At least 32 characters; generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
PAYMENT_WEBHOOK_SECRET=change-me-to-another-long-random-string-0123456789
# Minutes before an unpaid payment expires
PAYMENT_EXPIRE_MINUTES=15

# Which payment provider the "pay" button uses:
#   mock    - the backend's own checkout page with success / fail buttons (no account needed)
#   linepay - LINE Pay sandbox: no real money. Create a sandbox channel at
#             https://pay.line.me/tw/developers/techsupport/sandbox/creation
#             and put the Channel ID and Channel Secret it sends you below.
PAYMENT_PROVIDER=mock
PAYMENT_LINEPAY_CHANNEL_ID=
PAYMENT_LINEPAY_CHANNEL_SECRET=
# PAYMENT_LINEPAY_API_URL=https://sandbox-api-pay.line.me   (the default; the live API is https://api-pay.line.me)
